---
import Button from './Button.astro';
import type { Locale } from '../constants/i18n';
import { localePath, useTranslations } from '../utils/i18n-text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { href: '#courses', label: t('nav_courses') },
  { href: '#tasks', label: t('nav_tasks') },
  { href: '#videos', label: t('nav_videos') },
  { href: '#download', label: t('nav_download') },
];

const languageOptions = [
  { locale: 'en' as Locale, label: 'EN' },
  { locale: 'ru' as Locale, label: 'RU' },
];
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__logo" href={localePath(locale)}>
      <img class="header__emblem" src="/emblem.svg" alt="" width="372" height="339" />
      <span class="header__wordmark">Lexi</span>
    </a>

    <nav class="header__nav">
      {
        navItems.map(item => (
          <a class="header__link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <div class="header__lang" role="group" aria-label={t('footer_lang_title')}>
        {
          languageOptions.map(option => (
            <a
              class:list={['header__lang-item', { 'is-active': option.locale === locale }]}
              href={localePath(option.locale)}
              aria-current={option.locale === locale ? 'true' : undefined}
            >
              {option.label}
            </a>
          ))
        }
      </div>

      <Button href="#download">{t('nav_try')}</Button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    z-index: 50;
    top: 12px;
    right: 0;
    left: 0;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: 10px 12px 10px 20px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-pill);
    background: rgba(15, 15, 17, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    pointer-events: auto;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }

  .header.is-scrolled .header__inner {
    border-color: var(--border);
    background: rgba(10, 10, 12, 0.9);
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
  }

  .header__emblem {
    width: auto;
    height: 30px;
  }

  .header__wordmark {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: 18px;
  }

  .header__link {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 15px;
    font-weight: 500;
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .header__link:hover {
    background: var(--card-bg);
    color: var(--text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-inline-start: auto;
  }

  .header__lang {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--card-bg);
  }

  .header__lang-item {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .header__lang-item:hover {
    color: var(--text);
  }

  .header__lang-item.is-active {
    background: var(--control-bg-hover);
    color: var(--text);
  }

  @media (max-width: 1080px) {
    .header__nav {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .header__inner {
      padding: 8px 10px 8px 14px;
      gap: 8px;
    }

    .header__logo {
      gap: 8px;
    }

    .header__emblem {
      height: 24px;
    }

    .header__wordmark {
      font-size: 18px;
    }

    .header__actions {
      gap: 8px;
    }

    .header__lang {
      padding: 2px;
    }

    .header__lang-item {
      padding: 6px 9px;
    }

    .header__actions :global(.btn) {
      padding: 10px 16px;
      font-size: 14px;
    }
  }

  @media (max-width: 350px) {
    .header__wordmark {
      display: none;
    }
  }
</style>
