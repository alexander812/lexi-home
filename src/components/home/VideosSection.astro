---
import Icon from '../Icon.astro';
import Section from '../Section.astro';
import type { Locale } from '../../constants/i18n';
import { useTranslations } from '../../utils/i18n-text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const videos = [
  { base: 'overview', title: t('videos_card_tour_title'), text: t('videos_card_tour_text') },
  { base: 'task', title: t('videos_card_task_title'), text: t('videos_card_task_text') },
  { base: 'settings', title: t('videos_card_settings_title'), text: t('videos_card_settings_text') },
  { base: 'add-ready-course', title: t('videos_card_course_title'), text: t('videos_card_course_text') },
];
---

<Section
  id="videos"
  eyebrow={t('videos_eyebrow')}
  title={t('videos_title')}
  lead={t('videos_lead')}
  ctaHref="#download"
  ctaLabel={t('common_cta_download')}
>
  <ul class="videos">
    {
      videos.map((video, index) => (
        <li class="video" data-video data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          <div class="video__media">
            <video class="video__el" poster={`/videos/${video.base}.jpg`} preload="none" playsinline>
              <source src={`/videos/${video.base}.webm`} type="video/webm" />
              <source src={`/videos/${video.base}.mp4`} type="video/mp4" />
            </video>

            <button class="video__play" type="button" aria-label={t('videos_play')}>
              <Icon name="play" size={22} />
            </button>
          </div>

          <h3 class="video__title">{video.title}</h3>
          <p class="video__text">{video.text}</p>
        </li>
      ))
    }
  </ul>
</Section>

<script>
  const wrappers = Array.from(document.querySelectorAll<HTMLElement>('[data-video]'));

  wrappers.forEach(wrapper => {
    const video = wrapper.querySelector('video');
    const button = wrapper.querySelector('button');

    if (!video || !button) {
      return;
    }

    video.addEventListener('play', () => wrapper.classList.add('is-playing'));
    video.addEventListener('pause', () => wrapper.classList.remove('is-playing'));
    video.addEventListener('ended', () => wrapper.classList.remove('is-playing'));

    button.addEventListener('click', () => {
      wrappers.forEach(other => {
        if (other !== wrapper) {
          other.querySelector('video')?.pause();
        }
      });

      video.controls = true;

      const playback = video.play();

      if (playback) {
        playback.catch(() => {
          video.controls = false;
        });
      }
    });
  });
</script>

<style>
  .videos {
    display: grid;
    gap: 24px;
    margin-top: clamp(40px, 5vw, 64px);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .video {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .video__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 780 / 1180;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-soft);
    background: #000;
  }

  .video__media:hover .video__play {
    background: var(--accent);
    border-color: transparent;
  }

  .video__el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .video.is-playing .video__el {
    object-fit: contain;
    object-position: center;
  }

  .video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(246, 247, 255, 0.28);
    border-radius: 50%;
    background: rgba(5, 5, 5, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--text);
    text-indent: 4px;
    transition:
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }

  .video.is-playing .video__play {
    opacity: 0;
    pointer-events: none;
  }

  .video__title {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .video__text {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .video__play {
      transition:
        background-color 0.25s var(--ease-out),
        border-color 0.25s var(--ease-out),
        opacity 0.25s var(--ease-out),
        transform 0.25s var(--ease-out);
    }

    .video__media:hover .video__play {
      transform: translate(-50%, -50%) scale(1.06);
    }
  }
</style>
