---
import { Image } from 'astro:assets';

import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import Section from '../Section.astro';
import cardScreen from '../../assets/screenshots/card.png';
import tasksScreen from '../../assets/screenshots/tasks.png';
import type { Locale } from '../../constants/i18n';
import { useTranslations } from '../../utils/i18n-text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const sizes = '(max-width: 900px) 60vw, 320px';
const widths = [260, 380, 520, 640];

const firstSteps: { icon: IconName; title: string; text: string }[] = [
  { icon: 'file-text', title: t('tasks_step_1_title'), text: t('tasks_step_1_text') },
  { icon: 'move-horizontal', title: t('tasks_step_2_title'), text: t('tasks_step_2_text') },
  { icon: 'mic', title: t('tasks_step_3_title'), text: t('tasks_step_3_text') },
];

const secondSteps: { icon: IconName; title: string; text: string }[] = [
  { icon: 'keyboard', title: t('tasks_step_4_title'), text: t('tasks_step_4_text') },
  { icon: 'graduation-cap', title: t('tasks_step_5_title'), text: t('tasks_step_5_text') },
];
---

<Section
  id="tasks"
  eyebrow={t('tasks_eyebrow')}
  title={t('tasks_title')}
  lead={t('tasks_lead')}
  ctaHref="#download"
  ctaLabel={t('common_cta_download')}
>
  <div class="rows">
    <div class="row">
      <ol class="steps">
        {
          firstSteps.map((step, index) => (
            <li class="step" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <span class="step__icon">
                <Icon name={step.icon} size={20} />
              </span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="media-frame row__media" data-reveal style="--reveal-delay: 120ms">
        <Image src={cardScreen} alt={t('alt_card')} widths={widths} sizes={sizes} />
      </div>
    </div>

    <div class="row row--reverse">
      <ol class="steps">
        {
          secondSteps.map((step, index) => (
            <li class="step" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <span class="step__icon">
                <Icon name={step.icon} size={20} />
              </span>
              <div class="step__body">
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="media-frame row__media" data-reveal style="--reveal-delay: 120ms">
        <Image src={tasksScreen} alt={t('alt_tasks')} widths={widths} sizes={sizes} />
      </div>
    </div>
  </div>
</Section>

<style>
  .rows {
    display: flex;
    flex-direction: column;
    gap: clamp(60px, 7vw, 120px);
    margin-top: clamp(48px, 5vw, 72px);
  }

  .row {
    display: grid;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .step {
    display: flex;
    gap: 16px;
  }

  .step__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-m);
    background: var(--card-bg);
    color: var(--accent-hover);
  }

  .step__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 2px;
  }

  .step__title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .step__text {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.55;
    max-width: 460px;
  }

  .row__media {
    justify-self: center;
    width: min(320px, 70vw);
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .row--reverse {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .row--reverse .steps {
      order: 2;
    }

    .row__media {
      width: min(340px, 32vw);
    }
  }
</style>
