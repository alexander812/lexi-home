---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import Section from '../Section.astro';
import coursesScreen from '../../assets/screenshots/courses.png';
import lessonsScreen from '../../assets/screenshots/lessons.png';
import progressScreen from '../../assets/screenshots/progress.png';
import taskTextScreen from '../../assets/screenshots/task-text.png';
import type { Locale } from '../../constants/i18n';
import { useTranslations } from '../../utils/i18n-text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const cards: { icon: IconName; image: ImageMetadata; alt: string; title: string; text: string }[] = [
  {
    icon: 'sparkles',
    image: coursesScreen,
    alt: t('alt_courses'),
    title: t('courses_card_levels_title'),
    text: t('courses_card_levels_text'),
  },
  {
    icon: 'book-open',
    image: lessonsScreen,
    alt: t('alt_lessons'),
    title: t('courses_card_own_title'),
    text: t('courses_card_own_text'),
  },
  {
    icon: 'file-text',
    image: taskTextScreen,
    alt: t('alt_task_text'),
    title: t('courses_card_text_title'),
    text: t('courses_card_text_text'),
  },
  {
    icon: 'trophy',
    image: progressScreen,
    alt: t('alt_progress'),
    title: t('courses_card_progress_title'),
    text: t('courses_card_progress_text'),
  },
];
---

<Section
  id="courses"
  eyebrow={t('courses_eyebrow')}
  title={t('courses_title')}
  lead={t('courses_lead')}
  ctaHref="#download"
  ctaLabel={t('common_cta_download')}
>
  <ul class="cards">
    {
      cards.map((card, index) => (
        <li class="card" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
          <div class="card__media">
            <Image src={card.image} alt={card.alt} widths={[280, 420, 560]} sizes="(max-width: 900px) 90vw, 300px" />
          </div>

          <div class="card__body">
            <div class="card__head">
              <span class="card__icon">
                <Icon name={card.icon} size={18} />
              </span>
              <h3 class="card__title">{card.title}</h3>
            </div>
            <p class="card__text">{card.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .cards {
    display: grid;
    gap: 20px;
    margin-top: clamp(40px, 5vw, 64px);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-xl);
    background: var(--card-bg);
    transition:
      border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .card:hover {
    border-color: var(--border);
    background: var(--card-bg-hover);
    transform: translateY(-4px);
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(71, 99, 240, 0.28), rgba(5, 5, 5, 0.2));
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .card__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(180deg, transparent, rgba(5, 5, 5, 0.85));
    pointer-events: none;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 26px;
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-m);
    background: var(--accent-soft);
    color: var(--accent-hover);
  }

  .card__title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .card__text {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .card__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
