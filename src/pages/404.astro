---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { defaultLocale, useTranslations } from '../utils/i18n-text';

const locale = defaultLocale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('notfound_title')} description={t('notfound_text')} noindex>
  <section class="notfound container">
    <img class="notfound__logo" src="/emblem.svg" alt="Lexi" width="512" height="512" />
    <h1 class="title">{t('notfound_title')}</h1>
    <p class="lead">{t('notfound_text')}</p>
    <div class="notfound__cta">
      <Button href="/" size="l">
        <Icon slot="icon" name="arrow-right" size={20} />
        {t('notfound_cta')}
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-block: clamp(140px, 22vh, 240px) var(--section-gap);
    text-align: center;
  }

  .notfound__logo {
    width: 96px;
    height: 96px;
  }

  .notfound__cta {
    margin-top: 16px;
  }
</style>
